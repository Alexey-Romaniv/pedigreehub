# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/pedigreehub

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
# Bez tych zmiennych serwis działa w trybie dev: treść maila (z linkiem
# weryfikacyjnym / resetu hasła) trafia tylko do logów backendu.
# Po uzupełnieniu sprawdź konfigurację: yarn test-email adres@przyklad.pl
#
# Brevo (darmowe 300 maili/dobę, nie wymaga własnej domeny):
#   https://app.brevo.com → SMTP & API → SMTP
#   SMTP_USER = login z panelu (adres konta), SMTP_PASS = wygenerowany klucz SMTP
#   EMAIL_FROM musi być adresem zweryfikowanym w Brevo (Senders)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@pedigreehub.pl

# Alternatywy:
#   Resend (3000/mies., wymaga zweryfikowanej domeny):
#     SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=<API key>
#   Gmail (app password przy włączonym 2FA):
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<adres>  SMTP_PASS=<app password>

# Cloudinary (бесплатно: 25GB storage, 25GB bandwidth/month)
# Создай аккаунт на https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# CEIDG API (бесплатный государственный API)
# Для расширенного доступа зарегистрируйся на https://dane.biznes.gov.pl
# Базовый доступ работает без токена
CEIDG_TOKEN=


# Weryfikacja mikroczipów w publicznej bazie ZKwP (best-effort; false = wyłączona)
ZKWP_CHECK_ENABLED=true
